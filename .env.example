# Environment Configuration for PharmacyOS
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Database: SQLite for local portable zero-setup execution
# For PostgreSQL in production, change to: postgresql://user:password@localhost:5432/pharmacyos?schema=public
DATABASE_URL="file:./dev.db"

# Session Security
AUTH_SECRET="dev-insecure-secret-key-change-in-production-min32chars"

# File Uploads Directory
UPLOAD_DIR="./uploads"

# Payment Gateway (Mock mode active by default)
RAZORPAY_KEY_ID="rzp_test_mock_mode"
RAZORPAY_KEY_SECRET="mock_secret"
